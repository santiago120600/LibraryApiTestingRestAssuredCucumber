{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mvn install",
            "type": "shell",
            "command": "mvn",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "clean",
                "install",
                "-DskipTests"
            ],
            "problemMatcher": []
        },
        {
            "label": "podman compose up build",
            "type": "shell",
            "command": "podman",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "compose",
                "up",
                "--build",
                "-d"
            ],
            "problemMatcher": []
        },
         {
            "label": "podman compose up",
            "type": "shell",
            "command": "podman",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "compose",
                "up",
                "-d"
            ],
            "problemMatcher": []
        },
        {
            "label": "podman compose down",
            "type": "shell",
            "command": "podman",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "compose",
                "down"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run locally",
            "type": "shell",
            "command": "mvn",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "--%",
                "test",
                "-Dtest=io.github.santiago120600.runners.ETETestRunner",
                "-Denv=prod",
                "-Dproxy=false",
                "-Dconfig=docker"
            ],
            "problemMatcher": []
        }
    ]
}